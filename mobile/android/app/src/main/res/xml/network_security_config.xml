<?xml version="1.0" encoding="utf-8"?>
<!-- Kaizen talks to your own PC over plain http on your home network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
