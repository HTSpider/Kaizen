<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="kz_bg">#121417</color>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/kz_bg</item>
        <item name="colorPrimaryDark">@color/kz_bg</item>
        <item name="colorAccent">#C6F36B</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/kz_bg</item>
        <item name="android:statusBarColor">@color/kz_bg</item>
        <item name="android:navigationBarColor">@color/kz_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kz_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kz_fg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
